# Wanderer — Config
# Copia in .env e riempi con le tue chiavi

# Amadeus Self-Service (voli reali)
# Registrati: https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Tequila by Kiwi.com (low-cost)
# Registrati: https://tequila.kiwi.com/portal
TEQUILA_API_KEY=
TEQUILA_BASE_URL=https://tequila-api.kiwi.com

# Deutsche Bahn (treni, API pubblica — no chiave)
DB_BASE_URL=https://v6.db.transport.rest

# Server
WANDERER_PORT=8899